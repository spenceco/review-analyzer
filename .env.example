# --- AI provider ---------------------------------------------------------
# "gemini" for real analysis, "fake" for an offline keyword-based demo mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# "gemini-flash-lite-latest" is fast and reliable; "gemini-flash-latest" is smarter but slower and often overloaded (HTTP 503).
GEMINI_MODEL=gemini-flash-lite-latest

# --- Abuse / cost protection ----------------------------------------------
MAX_UPLOAD_BYTES=2097152
MAX_ROWS=200
# Analyses one IP may start per window.
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=3600
# Hard cap on AI API calls per UTC day, across all visitors (retries count).
DAILY_API_CALL_LIMIT=300
MAX_CONCURRENT_JOBS=3

# --- Batching ------------------------------------------------------------
BATCH_SIZE=25
BATCH_CONCURRENCY=2
MAX_RETRIES=4

# Where the daily usage counter is stored.
DATA_DIR=./data
